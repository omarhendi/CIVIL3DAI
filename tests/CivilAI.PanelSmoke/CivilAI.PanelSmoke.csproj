<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../src/CivilAI/Workspace/DarkTheme.xaml" LogicalName="CivilAI.DarkTheme.xaml" />
    <Compile Include="../../src/CivilAI/Workspace/*.cs" Link="Workspace/%(Filename)%(Extension)" />
    <Compile Include="../../src/CivilAI/InspectorPanel.cs" Link="InspectorPanel.cs" />
    <Compile Include="../../src/CivilAI/DrawingSnapshot.cs" Link="DrawingSnapshot.cs" />
  </ItemGroup>
<ItemGroup><Compile Include="../../src/CivilAI/SurfaceSummary.cs" Link="SurfaceSummary.cs" /></ItemGroup></Project>
