<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Official Autodesk 2026 APIs. Compile assets only: the host supplies runtime DLLs. -->
    <PackageReference Include="AutoCAD.NET" Version="[25.1.0]" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="Civil3D.NET" Version="[13.8.280]" GeneratePathProperty="true" IncludeAssets="none" PrivateAssets="all" />
    <!-- Select the Civil APIs used by this plugin, including its required AEC base types. -->
    <Reference Include="AeccDbMgd">
      <HintPath>$(PkgCivil3D_NET)/lib/net8.0/AeccDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>$(PkgCivil3D_NET)/lib/net8.0/AecBaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
